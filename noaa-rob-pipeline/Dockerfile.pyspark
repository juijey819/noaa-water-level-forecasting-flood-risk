FROM python:3.11-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PYSPARK_PYTHON=python
ENV PYSPARK_DRIVER_PYTHON=python
ENV SPARK_CHECKPOINT_DIR=/tmp/noaa_spark_checkpoints

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless curl ca-certificates procps && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-pyspark.txt /requirements-pyspark.txt
RUN pip install --no-cache-dir -r /requirements-pyspark.txt

CMD ["bash", "-lc", "spark-submit --master local[*] --conf spark.jars.ivy=/tmp/.ivy2 --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.postgresql:postgresql:42.7.3 src/streaming/spark_kafka_to_postgres.py"]
